<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10: WinRT Windows.Data.Pdf API for the PDF preview -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF: WIC image decoder (exact PNG / JPEG, no gamma correction) and MediaPlayer (FLAC playback) -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TornadoImageConverter</RootNamespace>
    <AssemblyName>TornadoImageConverter</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Product>Tornado Image Converter</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Removed from the implicit usings when UseWPF is active -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
